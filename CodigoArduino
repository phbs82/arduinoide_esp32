#include "DHT.h"

// Configurações do DHT11
#define DHTPIN 4       // Pino GPIO4 onde o DHT11 está conectado
#define DHTTYPE DHT11  // Tipo de sensor

// Inicializa o sensor DHT
DHT dht(DHTPIN, DHTTYPE);

void setup() {
  Serial.begin(9600);
  Serial.println("=== SENSOR DHT11 ===");
  Serial.println("Iniciando leitura...");
  
  dht.begin();  // Inicia o sensor
}

void loop() {
  // Aguarda 2 segundos entre leituras
  delay(2000);

  // Lê a umidade
  float umidade = dht.readHumidity();
  // Lê a temperatura em Celsius
  float temperatura = dht.readTemperature();

  // Verifica se a leitura foi bem sucedida
  if (isnan(umidade) || isnan(temperatura)) {
    Serial.println("❌ Erro na leitura do DHT11!");
    Serial.println("Verifique as conexões:");
    Serial.println("- DHT11 (+) → 3.3V");
    Serial.println("- DHT11 (OUT) → GPIO4");
    Serial.println("- DHT11 (-) → GND");
    return;
  }

  // Mostra os resultados no Monitor Serial
  Serial.println("✅ Leitura bem sucedida:");
  Serial.print("🌡️  Temperatura: ");
  Serial.print(temperatura);
  Serial.println(" °C");
  
  Serial.print("💧 Umidade: ");
  Serial.print(umidade);
  Serial.println(" %");
  
  Serial.println("----------------------");
}
